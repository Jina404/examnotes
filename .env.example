# ---------------------------------------------------------------------------
# ExamNotes configuration. Copy this file to .env and fill in your key.
#   cp .env.example .env
# .env is in .gitignore - never commit your real key.
# ---------------------------------------------------------------------------

# Which engine to use:
#   gemini      - the Google Gemini API (needs LLM_API_KEY below)
#   claude_cli  - the Claude Code CLI already installed on this machine.
#                 No API key: it reuses your terminal's login. Local testing
#                 only - it cannot run on a deployed server.
#   remote      - forward prompts to tools/llm_agent.py on your own machine
#                 (lets a HOSTED copy use your Claude Code - see the README)
#   fake        - fixed sample output, offline, used by the tests
# If LLM_API_KEY is empty the app falls back to "fake" automatically.
LLM_PROVIDER=gemini

# Get a free key at https://aistudio.google.com/apikey  (Google account needed).
LLM_API_KEY=

# Model id. Checked against Google's model list in November 2026.
# gemini-3.6-flash is a current stable Flash model and a good default.
# Alternatives, cheapest first:  gemini-3.5-flash-lite,  gemini-3.8-flash
# Google no longer prints free-tier quotas in the docs: check the limits for
# your own project at https://aistudio.google.com/rate-limit
LLM_MODEL=gemini-3.6-flash

# --- claude_cli provider only ---------------------------------------------
# Set LLM_PROVIDER=claude_cli and LLM_MODEL to a model id or a CLI alias
# ("opus", "sonnet", "haiku"). Leave LLM_MODEL empty to use whatever your
# terminal defaults to. LLM_API_KEY is ignored by this provider.
#   LLM_PROVIDER=claude_cli
#   LLM_MODEL=haiku
# Full path to the CLI, if it is not on PATH:
# LLM_CLI_PATH=/usr/local/bin/claude
# Seconds to wait for one CLI answer (default 300):
# LLM_CLI_TIMEOUT=300

# --- remote provider only (hosted app -> your machine) ---------------------
#   LLM_PROVIDER=remote
#   LLM_REMOTE_URL=https://your-tunnel.trycloudflare.com
#   LLM_REMOTE_TOKEN=<same secret the agent was started with>
# Seconds to wait for the agent (default 300):
# LLM_REMOTE_TIMEOUT=300

# Optional: where the SQLite file lives (defaults to ./data next to the app).
# EXAMNOTES_DATA_DIR=/var/data
